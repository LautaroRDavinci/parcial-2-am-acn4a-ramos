<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.FitRoutine" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="Theme.FitRoutine" parent="Base.Theme.FitRoutine" />

    <style name="TextStyle">
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextStyle.Title">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="TextStyle.Subtitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="Widget.FitRoutine.GoogleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/google_button_height</item>
        <item name="android:textColor">@color/google_button_text</item>
        <item name="android:textSize">@dimen/font_body_medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/google_button_stroke</item>
        <item name="strokeWidth">@dimen/google_button_stroke</item>
        <item name="cornerRadius">@dimen/google_button_radius</item>
        <item name="icon">@drawable/ic_google</item>
        <item name="iconSize">@dimen/google_icon_size</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/spacing_small</item>
        <item name="iconTint">@null</item>
    </style>

    <style name="Widget.FitRoutine.NavButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/nav_button_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/nav_button_margin</item>
        <item name="android:textSize">@dimen/font_nav_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
    </style>
</resources>
